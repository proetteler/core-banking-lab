# Kopieren nach .env und echte Werte eintragen. .env nie committen.

# Admin-Passwort für SYS und SYSTEM (nur Administration)
ORACLE_PASSWORD=change_me

# Applikations-Schema: hier liegen Tabellen und PL/SQL-Packages
APP_USER=CORE_BANK
APP_USER_PASSWORD=change_me

# Datenbank-User des Integrationsservice (CORE_BANK_API): nur Execute auf die Packages
API_USER_PASSWORD=change_me
